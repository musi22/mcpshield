# ===========================================================================
# MCPShield Zero-Local-Storage Cloud Production Configuration
# Estimated Infrastructure Cost: $0.00 / month (100% Free-Tier Architecture)
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Serverless Cloud Relational Database (PostgreSQL)
# Recommended: Neon (https://neon.tech) or Supabase (https://supabase.com)
# Free Tier: 0.5 GB Postgres, autoscaling to 0, automated backups, zero cold start.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-solitary-river-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# 2. Cloud Object Storage (Audit Chains, Scan Artifacts, Compliance Reports)
# Recommended: Cloudflare R2 (https://dash.cloudflare.com)
# Free Tier: 10 GB Storage / Month, $0 Egress Fees Worldwide, S3 compatible.
# ---------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id_hex
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mcpshield-cloud-vault
# Or standard AWS S3 / MinIO:
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# S3_BUCKET_NAME=mcpshield-cloud-vault

# ---------------------------------------------------------------------------
# 3. Serverless Distributed Cache & Rate Limiting
# Recommended: Upstash Serverless Redis (https://upstash.com)
# Free Tier: 10,000 commands/day free forever, zero server maintenance.
# ---------------------------------------------------------------------------
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@gusc1-your-db.upstash.io:6379

# ---------------------------------------------------------------------------
# 4. Core Security & Encryption
# ---------------------------------------------------------------------------
ENV=production
JWT_SECRET=mcpshield-prod-strong-crypto-key-change-this-now-881293812
MCP_ENFORCE_AGENT_AUTH=true

# ---------------------------------------------------------------------------
# 5. Incident Response Webhooks (Optional)
# ---------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
